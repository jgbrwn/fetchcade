{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/fetch",
      "/health"
    ],
    "not_found_handling": "single-page-application"
  }
}
